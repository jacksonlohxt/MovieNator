{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "producer-intake-decision-packet@1",
  "title": "PRD-target Producer Intake Decision Packet result contract",
  "description": "The strict bounded contract produced by POST /v1/producer-source-bundles/{bundle_id}/packets. It requires exactly one primary_screenplay in the underlying bundle, a per-source/version manifest, exact facts, a scene index, conflicts, an evidence-state-carrying decision/question register, and the full provenance object (contract_version, mode, bundle_manifest_hash, grounding_strategy, source_manifest_hash, fallback_used, retention_state). The older producer-decision-packet@1 shape remains a separate, unrenamed compatibility contract for the free-label /v1/producer-packets route; this schema does not describe that path.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflow", "status", "packet_id", "bundle_id", "created_at", "bundle", "executive_summary", "source_manifest", "exact_facts", "scene_index", "production_elements", "locations_and_timing", "cast_role_demands", "department_requirements", "schedule_inputs", "budget_inputs", "rights_access_logistics", "conflicts", "decision_question_register", "gaps_and_next_steps", "citations", "provenance", "limitations"],
  "properties": {
    "schema_version": { "const": "producer-intake-decision-packet@1" },
    "workflow": { "const": "producer_consolidation" },
    "status": { "enum": ["succeeded", "source_gap", "failed", "expired"] },
    "packet_id": { "type": "string", "pattern": "^packet_[A-Za-z0-9_-]+$" },
    "bundle_id": { "type": ["string", "null"], "pattern": "^bdl_[A-Za-z0-9_-]+$" },
    "created_at": { "type": "string" },
    "generated_at": { "type": "string" },
    "decision_context": { "type": ["string", "null"], "maxLength": 1000 },
    "bundle": { "$ref": "producer-source-bundle@1" },
    "executive_summary": { "$ref": "#/$defs/canonical_item" },
    "source_manifest": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/source" } },
    "source_inventory": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/source" } },
    "exact_facts": { "type": "array", "maxItems": 240, "items": { "$ref": "#/$defs/canonical_item" } },
    "scene_index": { "type": "array", "maxItems": 240, "items": { "$ref": "#/$defs/canonical_item" } },
    "production_elements": { "type": "array", "maxItems": 240, "items": { "$ref": "#/$defs/canonical_item" } },
    "locations_and_timing": { "type": "array", "maxItems": 240, "items": { "$ref": "#/$defs/canonical_item" } },
    "cast_role_demands": { "type": "array", "maxItems": 240, "items": { "$ref": "#/$defs/canonical_item" } },
    "department_requirements": { "type": "array", "maxItems": 240, "items": { "$ref": "#/$defs/canonical_item" } },
    "schedule_inputs": { "type": "array", "maxItems": 120, "items": { "$ref": "#/$defs/canonical_item" } },
    "budget_inputs": { "type": "array", "maxItems": 120, "items": { "$ref": "#/$defs/canonical_item" } },
    "rights_access_logistics": { "type": "array", "maxItems": 120, "items": { "$ref": "#/$defs/canonical_item" } },
    "conflicts": { "type": "array", "maxItems": 120, "items": { "$ref": "#/$defs/canonical_item" } },
    "decision_question_register": { "type": "array", "maxItems": 120, "items": { "$ref": "#/$defs/canonical_item" } },
    "gaps_and_next_steps": { "type": "array", "maxItems": 120, "items": { "$ref": "#/$defs/canonical_item" } },
    "cited_citation_ids": { "type": "array", "maxItems": 128, "items": { "type": "string" } },
    "citations": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/citation" } },
    "limitations": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "contract_version", "mode", "backend", "provider", "external", "read_only", "grounding_strategy", "bundle_manifest_hash", "source_manifest_hash", "fallback_used", "retention_state"],
      "properties": {
        "schema_version": { "const": "producer-provenance@1" },
        "contract_version": { "const": "producer-intake-decision-packet@1" },
        "mode": { "const": "demo" },
        "backend": { "type": "string" },
        "provider": { "type": "string" },
        "external": { "const": false },
        "read_only": { "const": true },
        "grounding_strategy": { "type": "string" },
        "bundle_manifest_hash": { "type": "string", "pattern": "^sha256:[A-Fa-f0-9]{16,}$" },
        "source_manifest_hash": { "type": "string", "pattern": "^sha256:[A-Fa-f0-9]{16,}$" },
        "fallback_used": { "type": "boolean" },
        "retention_state": { "type": "string" }
      }
    },
    "version_provenance": { "type": "object", "additionalProperties": true },
    "reconciliation": { "type": "object", "additionalProperties": true },
    "production_decisions": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "decision_register": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "risks_or_conflicts": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "cross_document_conflicts": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "gaps_or_questions": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "handoff": { "type": "object", "additionalProperties": true }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "filename", "media_type", "byte_size", "content_hash", "source_kind", "relationships", "ingestion_state", "truncated", "provenance", "limitations"],
      "properties": {
        "source_id": { "type": "string", "pattern": "^src_[A-Za-z0-9_-]+$" },
        "document_id": { "type": "string" },
        "input_ref": { "type": ["string", "null"], "maxLength": 120 },
        "filename": { "type": "string", "minLength": 1, "maxLength": 120 },
        "media_type": { "enum": ["application/pdf", "text/plain"] },
        "byte_size": { "type": "integer", "minimum": 1 },
        "content_hash": { "type": "string", "pattern": "^sha256:[A-Fa-f0-9]{16,}$" },
        "source_kind": { "enum": ["primary_screenplay", "screenplay_revision", "director_notes", "cast_notes", "location_access", "schedule_assumptions", "budget_assumptions", "rights_clearance", "department_input", "breakdown", "handoff", "other"] },
        "department": { "type": ["string", "null"], "maxLength": 80 },
        "version_label": { "type": ["string", "null"], "maxLength": 120 },
        "status_label": { "type": ["string", "null"], "maxLength": 120 },
        "relationships": { "type": "array", "maxItems": 4, "items": { "type": "object", "additionalProperties": false, "required": ["type", "target_input_ref"], "properties": { "type": { "enum": ["revises", "supports", "derived_from", "references", "conflicts_with", "unknown"] }, "target_input_ref": { "type": "string" } } } },
        "source_note": { "type": ["string", "null"], "maxLength": 240 },
        "ingestion_state": { "type": "string" },
        "truncated": { "type": "boolean" },
        "provenance": { "type": "string" },
        "limitations": { "type": "array", "maxItems": 8, "items": { "type": "string" } }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "citation_id", "source_id", "document_id", "filename", "media_type", "source_kind", "source_label", "source_locations", "excerpt"],
      "properties": {
        "schema_version": { "const": "producer-citation@1" },
        "citation_id": { "type": "string" },
        "source_id": { "type": "string" },
        "document_id": { "type": "string" },
        "filename": { "type": "string" },
        "media_type": { "enum": ["application/pdf", "text/plain"] },
        "source_kind": { "type": "string" },
        "source_label": { "type": "string" },
        "source_locations": { "type": "array" },
        "excerpt": { "type": "string", "maxLength": 900 }
      }
    },
    "canonical_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["citation_ids"],
      "properties": {
        "fact_id": { "type": "string" },
        "input_id": { "type": "string" },
        "scene_id": { "type": "string" },
        "entry_id": { "type": "string" },
        "gap_id": { "type": "string" },
        "conflict_id": { "type": "string" },
        "element_id": { "type": "string" },
        "entry_type": { "enum": ["decision", "open_question"] },
        "scene_reference": { "type": ["string", "null"], "maxLength": 700 },
        "scene_heading": { "type": ["string", "null"], "maxLength": 700 },
        "setting": { "type": ["string", "null"], "maxLength": 240 },
        "int_ext": { "type": ["string", "null"] },
        "time_of_day": { "type": ["string", "null"] },
        "shooting_order": { "type": ["integer", "null"] },
        "day_break": { "type": ["string", "null"] },
        "page_count": { "type": ["number", "null"] },
        "unit": { "type": ["string", "null"] },
        "location": { "type": ["object", "null"], "additionalProperties": false, "properties": { "kind": { "type": "string" }, "page": { "type": "integer" }, "section": { "type": "string" }, "line_start": { "type": "integer" }, "line_end": { "type": "integer" } } },
        "value": { "type": ["string", "null"], "maxLength": 700 },
        "text": { "type": ["string", "null"], "maxLength": 700 },
        "field": { "type": ["string", "null"] },
        "amount": { "type": ["string", "number", "null"] },
        "currency": { "type": ["string", "null"] },
        "original_wording": { "type": ["string", "null"], "maxLength": 700 },
        "normalization_basis": { "type": "string" },
        "classification": { "enum": ["source_fact", "source_implied_inference", "externally_supplied_fact", "human_assumption", "conflict", "open_question", "decision"] },
        "evidence_state": { "enum": ["established", "supplied_not_verified", "assumed", "not_established", "conflict", "recorded_decision", "stale", "unavailable"] },
        "inference_basis": { "type": "string" },
        "category": { "type": "string" },
        "department": { "type": ["string", "null"] },
        "source_id": { "type": "string" },
        "source_ids": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "citation_ids": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "provenance": { "type": "object", "additionalProperties": true },
        "limitations": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "owner": { "type": ["string", "null"], "maxLength": 120 },
        "priority": { "enum": ["high", "medium", "low", "unset"] },
        "priority_basis": { "type": "string", "maxLength": 180 },
        "related_to": { "type": ["string", "null"], "maxLength": 700 },
        "title": { "type": "string", "maxLength": 180 },
        "next_action": { "type": "string", "maxLength": 700 },
        "assertions": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/canonical_item" } },
        "impact": { "type": "string", "maxLength": 700 },
        "question": { "type": "string", "maxLength": 700 },
        "kind": { "type": "string" },
        "why_it_matters": { "type": "string", "maxLength": 700 },
        "evidence_needed": { "type": "string", "maxLength": 700 }
      }
    }
  }
}
