{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "readiness-brief@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "workflow", "run_status", "decision", "headline", "summary", "resolved_asset", "checks", "risks", "recommendations", "gaps", "coverage", "policy_version", "provenance", "limitations"],
  "properties": {
    "schema_version": { "const": "readiness-brief@1" },
    "run_id": { "type": "string", "maxLength": 160 },
    "workflow": { "const": "audience_data_readiness" },
    "run_status": { "type": "string" },
    "decision": { "enum": ["READY", "REVIEW", "BLOCKED", "UNKNOWN"] },
    "headline": { "type": "string", "maxLength": 180 },
    "summary": { "type": "string", "maxLength": 1200 },
    "resolved_asset": { "type": ["object", "null"], "additionalProperties": false, "properties": { "asset_id": { "type": "string", "maxLength": 160 }, "display_name": { "type": "string", "maxLength": 240 }, "workspace": { "type": "string", "maxLength": 200 }, "evidence_id": { "type": "string", "maxLength": 160 } } },
    "summary_evidence_ids": { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 160 } },
    "summary_claims": { "type": "array", "maxItems": 4 },
    "checks": { "type": "array", "maxItems": 4 },
    "risks": { "type": "array", "maxItems": 5 },
    "recommendations": { "type": "array", "maxItems": 3 },
    "gaps": { "type": "array", "maxItems": 4 },
    "coverage": { "type": "object" },
    "policy_version": { "type": "string", "maxLength": 80 },
    "policy_disclosure": { "type": "string", "maxLength": 300 },
    "policy_reasons": { "type": "array", "maxItems": 12 },
    "policy_decision": { "$ref": "policy-decision@1" },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["model", "provider", "label", "model_backend", "provider_backend", "metrics"], "properties": { "model": { "type": "string", "maxLength": 80 }, "provider": { "type": "string", "maxLength": 80 }, "label": { "type": "string", "maxLength": 160 }, "model_backend": { "type": "object", "additionalProperties": false, "required": ["backend", "model_id", "location", "api_version", "prompt_id", "prompt_hash", "schema_version", "schema_hash", "generation_config_hash"], "properties": { "backend": { "type": "string", "maxLength": 40 }, "model_id": { "type": ["string", "null"], "maxLength": 160 }, "location": { "type": ["string", "null"], "maxLength": 80 }, "api_version": { "type": ["string", "null"], "maxLength": 40 }, "prompt_id": { "type": ["string", "null"], "maxLength": 80 }, "prompt_hash": { "type": ["string", "null"], "maxLength": 100 }, "schema_version": { "type": ["string", "null"], "maxLength": 80 }, "schema_hash": { "type": ["string", "null"], "maxLength": 100 }, "generation_config_hash": { "type": ["string", "null"], "maxLength": 100 } } }, "provider_backend": { "type": "object", "additionalProperties": false, "required": ["backend", "provider_id", "manifest_hash", "semantic_operation"], "properties": { "backend": { "type": "string", "maxLength": 40 }, "provider_id": { "type": ["string", "null"], "maxLength": 160 }, "manifest_hash": { "type": ["string", "null"], "maxLength": 160 }, "semantic_operation": { "type": "string", "maxLength": 120 } } }, "metrics": { "type": "object", "additionalProperties": false, "required": ["call_count", "repair_count", "latency_ms", "input_chars", "output_chars", "response_hash", "error_class"], "properties": { "call_count": { "type": "integer", "minimum": 0, "maximum": 2 }, "repair_count": { "type": "integer", "minimum": 0, "maximum": 1 }, "latency_ms": { "type": "integer", "minimum": 0, "maximum": 120000 }, "input_chars": { "type": "integer", "minimum": 0, "maximum": 8000 }, "output_chars": { "type": "integer", "minimum": 0, "maximum": 12000 }, "response_hash": { "type": ["string", "null"], "maxLength": 160 }, "error_class": { "type": ["string", "null"], "maxLength": 80 } } } } },
    "limitations": { "type": "array", "maxItems": 5, "items": { "type": "string", "maxLength": 300 } }
  }
}
