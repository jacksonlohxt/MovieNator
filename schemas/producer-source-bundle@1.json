{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "producer-source-bundle@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_count", "source_ids", "total_bytes", "total_extracted_chars"],
  "properties": {
    "schema_version": { "const": "producer-source-bundle@1" },
    "source_count": { "type": "integer", "minimum": 1, "maximum": 8 },
    "source_ids": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "pattern": "^source_[A-Za-z0-9_-]+$" } },
    "total_bytes": { "type": "integer", "minimum": 1 },
    "total_extracted_chars": { "type": "integer", "minimum": 1 }
  }
}
